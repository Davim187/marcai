{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @marcai/web exec vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://SUA-API.up.railway.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://SUA-API.up.railway.app/uploads/:path*" },
    { "source": "/sitemap.xml", "destination": "https://SUA-API.up.railway.app/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://SUA-API.up.railway.app/robots.txt" },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|googlebot|bingbot|pinterest).*"
        }
      ],
      "destination": "https://SUA-API.up.railway.app/api/public/og?path=/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    },
    { "source": "/sw.js", "headers": [{ "key": "cache-control", "value": "no-cache" }] }
  ]
}
