# =============================================================
#  Marcaí — variáveis de ambiente da API
#  Copie para .env e ajuste. NUNCA faça commit do .env.
# =============================================================

# --- Geral ---------------------------------------------------
NODE_ENV=development
PORT=3333
# "saas" (multi-tenant, padrão) ou "single_tenant" (modo exclusivo / white-label)
APP_MODE=saas
# No modo exclusivo: slug do único estabelecimento atendido por esta instalação
SINGLE_TENANT_SLUG=studiovertice
# URL pública do front (usada em links de e-mail/WhatsApp e no CORS)
APP_URL=http://localhost:5173
# URL pública da API (usada no callback do Google e nos webhooks)
API_URL=http://localhost:3333
# Nome da marca exibido em e-mails (no modo exclusivo, usa-se o nome do tenant)
APP_NAME=Marcaí
# Origens extras liberadas no CORS, separadas por vírgula
CORS_ORIGINS=

# --- Banco ---------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marcai?schema=public

# --- Sessão / segurança --------------------------------------
# Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres
SESSION_TTL_DAYS=30
# "lax" quando front e API estão no mesmo domínio (recomendado, via proxy /api).
# "none" se front e API estiverem em domínios diferentes (exige HTTPS).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Login com Google (opcional) -----------------------------
# Console: https://console.cloud.google.com/apis/credentials
# URI de redirecionamento autorizado: {API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail (Resend) -----------------------------------------
# Sem RESEND_API_KEY, os e-mails são apenas registrados no log.
RESEND_API_KEY=
EMAIL_FROM="Marcaí <nao-responda@marcai.app>"

# --- Web Push (VAPID) ----------------------------------------
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@marcai.app

# --- WhatsApp ------------------------------------------------
# "console" (só loga), "evolution" (Evolution API self-hosted) ou "meta" (WhatsApp Cloud API)
WHATSAPP_PROVIDER=console
# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
# Segredo enviado pela Evolution no header "apikey" dos webhooks
EVOLUTION_WEBHOOK_SECRET=
# Meta Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
# Nome e idioma do template aprovado na Meta (corpo com 1 variável: {{1}} = mensagem)
META_WA_TEMPLATE_NAME=marcai_aviso
META_WA_TEMPLATE_LANG=pt_BR

# --- Cobrança (Mercado Pago) -------------------------------
# "fake" (simula cobranças em desenvolvimento) ou "mercadopago"
BILLING_PROVIDER=fake
# Access token da conta (Suas integrações → Credenciais). TEST-... para testes, APP_USR-... em produção
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações → Webhooks). Eventos: Pagamentos,
# Planos e assinaturas. URL: {API_URL}/api/webhooks/mercadopago
MP_WEBHOOK_SECRET=
MP_API_URL=https://api.mercadopago.com
# Dias antes do vencimento para gerar a fatura PIX/boleto e avisar por e-mail
BILLING_INVOICE_DAYS_BEFORE=5

# --- Worker / fila -------------------------------------------
# Roda o worker da fila dentro do processo da API (prático no dev; em produção use "pnpm start:worker")
RUN_WORKER_IN_API=true
WORKER_POLL_MS=3000

# --- Uploads -------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Front servido pela API (opcional) ----------------------
# Caminho para apps/web/dist: a API passa a servir o SPA e injeta meta tags Open Graph
WEB_DIST_DIR=
